    "updated_at": "2026-10-03",
    "benchmarks_catalog": {
      "SWE-bench": {
        "variants": ["Lite (300 tasks)", "Verified (500 human-validated tasks)", "Pro (Repository-scale multi-repo tasks)"],
        "metric": "Resolve Rate (pass@1 %)",
        "relevance": "Gold standard for multi-file autonomous software engineering bug resolution."
      },
      "Terminal-Bench": {
        "versions": {
          "1.0": "Initial 2025 CLI agent benchmark measuring basic terminal tool use.",
          "2.0": "Curated 89 hard tasks covering SWE, system admin, data processing, model training, security.",
          "3.0": "Expanded CI/CD and result migrations with continuous evaluation.",
          "4.0": "August 2026 release with 66 re-calibrated tasks, resource limits, removing saturated/refusal-prone tasks."
        },
        "metric": "Task Completion Rate (%) in sandboxed Docker CLI environment",
        "relevance": "Measures genuine end-to-end OS/terminal execution autonomy beyond static code generation."
      },
      "TAU-bench": {
        "domains": ["Airline", "Retail", "Banking"],
        "metric": "Multi-turn Policy Adherence & Success Rate (%)",
        "relevance": "Evaluates complex multi-turn stateful tool use and business constraint compliance."
      },
      "BFCL": {
        "name": "Berkeley Function Calling Leaderboard",
        "metric": "Overall Accuracy (%)",
        "relevance": "Micro-level function calling schema adherence, parallel tool calling, and irrelevant call rejection."
      },
      "OSWorld / Computer Use": {
        "metric": "GUI Task Completion Rate (%)",
        "relevance": "Screen pixel observation, mouse/keyboard coordinate action execution."
      }
    }
  },
